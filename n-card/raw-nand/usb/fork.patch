diff --git a/source/msc.c b/source/msc.c
index 093e19f..8b43daf 100644
--- a/source/msc.c
+++ b/source/msc.c
@@ -27,16 +27,48 @@

 #include "tusb.h"
 #include "ui.h"
+#include "nrio_raw_dldi.h"

 DTCM_DATA static bool ejected = false;
 DTCM_DATA static bool errata_last_sector = false;

+static struct nrio_raw_info raw_info;
+static bool raw_driver;
+static bool raw_writable;
+static uint32_t raw_workspace[NRIO_RAW_WORKSPACE_BYTES / sizeof(uint32_t)]
+    __attribute__((aligned(4)));
+
 // Initialize DLDI driver.
 ITCM_CODE bool msc_dldi_initialize(void) {
   const DISC_INTERFACE *io = dldiGetInternal();
+#if NRIO_RAW_REQUIRED
+  if (memcmp(&io->ioType, "NRWR", 4)) {
+    printf(UI_COLOR_ERROR "Raw NAND driver missing. Check DLDI auto-patching.\n");
+    return false;
+  }
+#endif
   if (!io->startup() || !io->isInserted())
     return false;

+  raw_driver = !memcmp(&io->ioType, "NRWR", 4);
+  if (raw_driver) {
+    if (!io->readSectors(NRIO_RAW_INFO_LBA, 0, &raw_info) ||
+        raw_info.version != NRIO_RAW_ABI_VERSION || raw_info.sectors == 0) {
+      printf(UI_COLOR_ERROR "Could not read raw NAND geometry.\n");
+      return false;
+    }
+    raw_writable = raw_info.workspace_bytes != 0;
+    if (raw_writable &&
+        (raw_info.workspace_bytes > sizeof(raw_workspace) ||
+         !io->readSectors(NRIO_RAW_WORKSPACE_LBA, sizeof(raw_workspace), raw_workspace))) {
+      printf(UI_COLOR_ERROR "Could not bind the raw NAND erase-block buffer.\n");
+      return false;
+    }
+    printf(UI_COLOR_INFO "Raw NAND %s (%lu sectors).\n",
+           raw_writable ? "read/write" : "read-only", (unsigned long)raw_info.sectors);
+    return true;
+  }
+
   // Some cartridges crash upon trying to access the final sector.
   if (
     !memcmp(&io->ioType, "SG3D", 4) /* TODO: Verify */
@@ -83,6 +115,9 @@ DTCM_DATA static uint32_t block_count_cached = 0;
 DTCM_DATA static uint8_t sec_buffer[512];

 ITCM_CODE uint32_t msc_find_block_count(void) {
+  if (raw_driver)
+    return raw_info.sectors;
+
 //   uint8_t sec_buffer[512];
   if (block_count_cached)
     return block_count_cached;
@@ -154,10 +189,20 @@ ITCM_CODE bool tud_msc_start_stop_cb(uint8_t lun, uint8_t power_condition, bool
   return true;
 }

+// Keep host requests within the physical disk, away from the private DLDI calls.
+static bool raw_lba_out_of_range(uint32_t lba, uint32_t size) {
+  return raw_driver && (lba >= raw_info.sectors ||
+                        (size >> 9) > raw_info.sectors - lba);
+}
+
 // Callback invoked when received READ10 command.
 // Copy disk's data to buffer (up to bufsize) and return number of copied bytes.
 ITCM_CODE int32_t tud_msc_read10_cb(uint8_t lun, uint32_t lba, uint32_t offset, void* buffer, uint32_t bufsize) {
   const DISC_INTERFACE *io = dldiGetInternal();
+  if (raw_lba_out_of_range(lba, bufsize)) {
+    tud_msc_set_sense(lun, SCSI_SENSE_ILLEGAL_REQUEST, 0x21, 0);
+    return -1;
+  }

   ui_toggle_blink_activity();
   if (!(bufsize & 0x1FF) && !offset && io->readSectors(lba, bufsize >> 9, buffer)) {
@@ -166,6 +211,10 @@ ITCM_CODE int32_t tud_msc_read10_cb(uint8_t lun, uint32_t lba, uint32_t offset,
   } else {
     ui_toggle_blink_activity();
     printf(UI_COLOR_ERROR "Read error [%ld, %ld]\n", lba, bufsize);
+    if (raw_driver) {
+      tud_msc_set_sense(lun, SCSI_SENSE_MEDIUM_ERROR, 0x11, 0);
+      return -1;
+    }
     return 0;
   }
 }
@@ -173,13 +222,21 @@ ITCM_CODE int32_t tud_msc_read10_cb(uint8_t lun, uint32_t lba, uint32_t offset,
 ITCM_CODE bool tud_msc_is_writable_cb(uint8_t lun) {
   (void) lun;

-  return true;
+  return !raw_driver || raw_writable;
 }

 // Callback invoked when received WRITE10 command.
 // Process data in buffer to disk's storage and return number of written bytes
 ITCM_CODE int32_t tud_msc_write10_cb(uint8_t lun, uint32_t lba, uint32_t offset, uint8_t* buffer, uint32_t bufsize) {
   const DISC_INTERFACE *io = dldiGetInternal();
+  if (raw_lba_out_of_range(lba, bufsize)) {
+    tud_msc_set_sense(lun, SCSI_SENSE_ILLEGAL_REQUEST, 0x21, 0);
+    return -1;
+  }
+  if (raw_driver && !raw_writable) {
+    tud_msc_set_sense(lun, SCSI_SENSE_DATA_PROTECT, 0x27, 0);
+    return -1;
+  }

   ui_toggle_blink_write_activity();
   if (!(bufsize & 0x1FF) && !offset && io->writeSectors(lba, bufsize >> 9, buffer)) {
@@ -188,6 +245,10 @@ ITCM_CODE int32_t tud_msc_write10_cb(uint8_t lun, uint32_t lba, uint32_t offset,
   } else {
     ui_toggle_blink_write_activity();
     printf(UI_COLOR_ERROR "Write error [%ld, %ld]\n", lba, bufsize);
+    if (raw_driver) {
+      tud_msc_set_sense(lun, SCSI_SENSE_MEDIUM_ERROR, 0x0c, 0);
+      return -1;
+    }
     return 0;
   }
 }
diff --git a/source/nrio_raw_dldi.h b/source/nrio_raw_dldi.h
new file mode 100755
index 0000000..fe18e76
--- /dev/null
+++ b/source/nrio_raw_dldi.h
@@ -0,0 +1,19 @@
+#ifndef NRIO_RAW_DLDI_PROTOCOL_H
+#define NRIO_RAW_DLDI_PROTOCOL_H
+
+#include <stdint.h>
+
+#define NRIO_RAW_INFO_LBA UINT32_C(0xffffffff)
+#define NRIO_RAW_WORKSPACE_LBA UINT32_C(0xfffffffe)
+#define NRIO_RAW_ABI_VERSION UINT32_C(1)
+#define NRIO_RAW_WORKSPACE_BYTES (128u * (2048u + 64u))
+
+/* Private DLDI calls use count=0 for info and count=workspace bytes for binding. */
+struct nrio_raw_info {
+    uint32_t version;
+    uint32_t sectors;
+    uint32_t workspace_bytes;
+    uint32_t nand_id;
+};
+
+#endif
