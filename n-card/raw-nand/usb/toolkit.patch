diff --git a/source/main.c b/source/main.c
index 7138d36..947743e 100644
--- a/source/main.c
+++ b/source/main.c
@@ -35,0 +36,2 @@
+#include "boot-repair.h"
+#include "nrio_raw_dldi.h"
@@ -53,0 +56,89 @@ static void exit_to_loader(void) {
+static bool wait_for_cart(const DISC_INTERFACE *io) {
+  if (memcmp(&io->ioType, "NRWR", 4)) {
+    printf(UI_COLOR_ERROR "Toolkit DLDI missing.\n");
+    exit_to_loader();
+    return false;
+  }
+
+  consoleClear();
+  printf("N-Card Recovery Toolkit\n\n"
+         "Insert N-Card in Slot-1.\n"
+         "A: detect   B: exit\n");
+  while (1) {
+    swiWaitForVBlank();
+    scanKeys();
+    uint32_t down = keysDown();
+    if (down & KEY_B)
+      return false;
+    if (!(down & KEY_A))
+      continue;
+    if (io->startup() && io->isInserted())
+      return true;
+    io->shutdown();
+    consoleClear();
+    printf("N-Card did not respond.\n\n"
+           "Check the cart in Slot-1.\n"
+           "A: retry   B: exit\n");
+  }
+}
+
+static const char *const mode_names[] = {
+  [NRIO_RAW_MAIN_READ] = "Main: read only",
+  [NRIO_RAW_SPARE_READ] = "Spare: read only",
+  [NRIO_RAW_MAIN_PROTECTED] = "Main: protect boot block",
+  [NRIO_RAW_MAIN_WRITE] = "Main: full recovery write",
+  [NRIO_RAW_SPARE_WRITE] = "Spare: recovery write",
+  [NRIO_RAW_BANNER_WRITE] = "Banner: prepared ROM only",
+  [NRIO_RAW_TABLE_REPAIR] = "Repair primary boot table",
+};
+
+static bool confirm_write(enum nrio_raw_mode mode) {
+  consoleClear();
+  printf("%s\n\n", mode_names[mode]);
+  printf(UI_COLOR_ERROR "Writes can erase boot data.\n");
+  printf("\x1b[0mKeep a main and spare backup.\n\nHold L + R and press A.\nPress B to go back.\n");
+  while (1) {
+    swiWaitForVBlank();
+    scanKeys();
+    uint32_t down = keysDown();
+    if (down & KEY_B)
+      return false;
+    if ((down & KEY_A) && (keysHeld() & (KEY_L | KEY_R)) == (KEY_L | KEY_R))
+      return true;
+  }
+}
+
+static enum nrio_raw_mode choose_mode(void) {
+  enum nrio_raw_mode mode = NRIO_RAW_MAIN_READ;
+  while (1) {
+    consoleClear();
+    printf("N-Card Recovery Toolkit\n\n");
+    for (unsigned i = 0; i < sizeof(mode_names) / sizeof(mode_names[0]); ++i)
+      printf("%c %s\n", i == mode ? '>' : ' ', mode_names[i]);
+    printf("\nUp/Down: mode   A: select\nB: exit\n\nConnect USB after selecting.\n");
+    while (1) {
+      swiWaitForVBlank();
+      scanKeys();
+      uint32_t down = keysDown();
+      if (down & KEY_B)
+        exit(0);
+      if (down & KEY_UP) {
+        mode = mode == NRIO_RAW_MAIN_READ ? NRIO_RAW_TABLE_REPAIR : mode - 1;
+        break;
+      }
+      if (down & KEY_DOWN) {
+        mode = mode == NRIO_RAW_TABLE_REPAIR ? NRIO_RAW_MAIN_READ : mode + 1;
+        break;
+      }
+      if (down & KEY_A) {
+        if (mode < NRIO_RAW_MAIN_PROTECTED || mode == NRIO_RAW_TABLE_REPAIR || confirm_write(mode)) {
+          consoleClear();
+          printf("%s\n\n", mode_names[mode]);
+          return mode;
+        }
+        break;
+      }
+    }
+  }
+}
+
@@ -86,6 +176,0 @@ int main(void) {
-  tusb_rhport_init_t dev_init = {
-    .role = TUSB_ROLE_DEVICE,
-    .speed = TUSB_SPEED_AUTO
-  };
-  bool usb_init_status = !isDSiMode() && tusb_init(BOARD_TUD_RHPORT, &dev_init);
-
@@ -97 +182,2 @@ int main(void) {
-  ui_show_chip_id();
+  if (!wait_for_cart(dldiGetInternal()))
+    return 0;
@@ -99,2 +185,3 @@ int main(void) {
-  if (!usb_init_status) {
-    printf(UI_COLOR_ERROR "Could not initialize USB!\n");
+  enum nrio_raw_mode mode = choose_mode();
+  if (mode == NRIO_RAW_TABLE_REPAIR) {
+    boot_repair();
@@ -103,2 +190 @@ int main(void) {
-
-  if (!msc_dldi_initialize()) {
+  if (!msc_dldi_initialize(mode)) {
@@ -109 +195,12 @@ int main(void) {
-  printf(UI_COLOR_INFO "Ready. Press START to exit.\n");
+  tusb_rhport_init_t dev_init = {
+    .role = TUSB_ROLE_DEVICE,
+    .speed = TUSB_SPEED_AUTO
+  };
+  if (!tusb_init(BOARD_TUD_RHPORT, &dev_init)) {
+    printf(UI_COLOR_ERROR "Could not initialize USB!\n");
+    exit_to_loader();
+  }
+
+  ui_show_chip_id();
+
+  printf(UI_COLOR_INFO "Ready. Eject before START.\n");
