+#include "boot-repair.h"
+#include "nrio_raw_dldi.h"
+#include "session-log.h"
@@ -53,0 +57,97 @@ static void exit_to_loader(void) {
+static bool wait_for_cart(const DISC_INTERFACE *io) {
+  if (memcmp(&io->ioType, "NRWR", 4)) {
+    session_log("Toolkit DLDI missing.");
+    return false;
+  }
+
+  consoleClear();
+  printf("N-Card Recovery Toolkit\n\n"
+         "Insert N-Card in Slot-1.\n"
+         "A: detect   B: back\n");
+  while (1) {
+    swiWaitForVBlank();
+    scanKeys();
+    uint32_t down = keysDown();
+    if (down & KEY_B) {
+      session_log("Cart detection cancelled.");
+      return false;
+    }
+    if (!(down & KEY_A))
+      continue;
+    session_log("Probing Slot-1 NAND.");
+    if (io->startup() && io->isInserted()) {
+      session_log("N-Card detected.");
+      return true;
+    }
+    io->shutdown();
+    consoleClear();
+    session_log("N-Card did not respond.");
+    printf("\nCheck the cart in Slot-1.\nA: retry   B: back\n");
+  }
+}
+
+// This menu item uses the existing read-only driver views.
+enum { CHECK_RECOVERY = NRIO_RAW_TABLE_REPAIR + 1 };
+
+static const char *const mode_names[] = {
+  [NRIO_RAW_MAIN_READ] = "Main: read only",
+  [NRIO_RAW_SPARE_READ] = "Spare: read only",
+  [NRIO_RAW_MAIN_PROTECTED] = "Main: protect boot block",
+  [NRIO_RAW_MAIN_WRITE] = "Main: full recovery write",
+  [NRIO_RAW_SPARE_WRITE] = "Spare: recovery write",
+  [NRIO_RAW_BANNER_WRITE] = "Banner: prepared ROM only",
+  [NRIO_RAW_TABLE_REPAIR] = "Repair primary boot table",
+  [CHECK_RECOVERY] = "Check recovery only",
+};
+
+static bool confirm_write(enum nrio_raw_mode mode) {
+  consoleClear();
+  printf("%s\n\n", mode_names[mode]);
+  printf(UI_COLOR_ERROR "Writes can erase boot data.\n");
+  printf("\x1b[0mKeep a main and spare backup.\n\nHold L + R and press A.\nPress B to go back.\n");
+  while (1) {
+    swiWaitForVBlank();
+    scanKeys();
+    uint32_t down = keysDown();
+    if (down & KEY_B)
+      return false;
+    if ((down & KEY_A) && (keysHeld() & (KEY_L | KEY_R)) == (KEY_L | KEY_R))
+      return true;
+  }
+}
+
+static int choose_mode(void) {
+  unsigned mode = NRIO_RAW_MAIN_READ;
+  while (1) {
+    consoleClear();
+    printf("N-Card Recovery Toolkit\n\n");
+    for (unsigned i = 0; i < sizeof(mode_names) / sizeof(mode_names[0]); ++i)
+      printf("%c %s\n", i == mode ? '>' : ' ', mode_names[i]);
+    printf("\nUp/Down: mode   A: select\nB: finish\n\nConnect USB after selecting.\n");
+    while (1) {
+      swiWaitForVBlank();
+      scanKeys();
+      uint32_t down = keysDown();
+      if (down & KEY_B)
+        return -1;
+      if (down & KEY_UP) {
+        mode = mode == NRIO_RAW_MAIN_READ ? CHECK_RECOVERY : mode - 1;
+        break;
+      }
+      if (down & KEY_DOWN) {
+        mode = mode == CHECK_RECOVERY ? NRIO_RAW_MAIN_READ : mode + 1;
+        break;
+      }
+      if (down & KEY_A) {
+        if (mode < NRIO_RAW_MAIN_PROTECTED || mode >= NRIO_RAW_TABLE_REPAIR || confirm_write(mode)) {
+          consoleClear();
+          session_log("Mode: %s", mode_names[mode]);
+          return mode;
+        }
+        session_log("Write mode cancelled: %s", mode_names[mode]);
+        break;
+      }
+    }
+  }
+}
+
