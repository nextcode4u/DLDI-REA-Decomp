+static int choose_mode(void) {
+  unsigned mode = NRIO_RAW_MAIN_READ;
+  while (1) {
+    consoleClear();
+    printf("N-Card Recovery Toolkit\n\n");
+    for (unsigned i = 0; i < sizeof(mode_names) / sizeof(mode_names[0]); ++i)
+      printf("%c %s\n", i == mode ? '>' : ' ', mode_names[i]);
+    printf("\nUp/Down: mode   A: select\nB: finish\n\nConnect USB after selecting.\n");
+    while (1) {
+      swiWaitForVBlank();
+      scanKeys();
+      uint32_t down = keysDown();
+      if (down & KEY_B)
+        return -1;
+      if (down & KEY_UP) {
+        mode = mode == NRIO_RAW_MAIN_READ ? CHECK_SAFE_MODE : mode - 1;
+        break;
+      }
+      if (down & KEY_DOWN) {
+        mode = mode == CHECK_SAFE_MODE ? NRIO_RAW_MAIN_READ : mode + 1;
+        break;
+      }
+      if (down & KEY_A) {
+        if (mode < NRIO_RAW_MAIN_PROTECTED || mode == NRIO_RAW_TABLE_REPAIR ||
+            mode == CHECK_RECOVERY || mode == CHECK_SAFE_MODE ||
+            (mode == NRIO_RAW_SAFE_MODE_INSTALL && !nrio_recovery_safe_mode_ready()) ||
+            confirm_write(mode)) {
+          consoleClear();
+          session_log("Mode: %s", mode_names[mode]);
+          return mode;
+        }
+        session_log("Write mode cancelled: %s", mode_names[mode]);
+        break;
+      }
+    }
+  }
+}
