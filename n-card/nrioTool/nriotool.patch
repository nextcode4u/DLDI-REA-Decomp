+			size_t row = 2;
+			for (size_t i = 0; i < visibleCount; ++i) {
+				if (i && (visibleCount <= 7 || i % 2 == 0)) {
+					putchar('\n');
+					++row;
+				}
+				printf("%c %s\n", i == selected ? '>' : ' ', visible[i]->label);
+				++row;
+			}
